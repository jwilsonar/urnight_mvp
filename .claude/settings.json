{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diagramas/detectar.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diagramas/validar-mermaid.mjs\"",
            "timeout": 30,
            "statusMessage": "Validando sintaxis Mermaid"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diagramas/recordar.mjs\"",
            "timeout": 15,
            "statusMessage": "Revisando diagramas de secuencia"
          }
        ]
      }
    ]
  }
}
