# ============================================================================
# UrNight — variables de entorno (plantilla). Copiar a `.env` y ajustar.
# Seccionado por app. Un solo .env en la raíz alimenta a todas (monorepo).
# Fuente autoritativa por app:
#   API      → apps/api/src/config/env.schema.ts (validado al arrancar)
#   Web      → NEXT_PUBLIC_* (cliente) + AUTH_* (NextAuth v5, servidor)
#   Mobile   → EXPO_PUBLIC_* (apps/mobile) · Validator → EXPO_PUBLIC_* (apps/validator)
# ============================================================================


# ── API  (apps/api, apps/worker, packages/db) ───────────────────────────────
# PostgreSQL (dev local: puerto 5433, ver docker-compose.yml / ADR 0001).
DATABASE_URL="postgresql://urnight:urnight@localhost:5433/urnight_dev"
# Redis (sesiones, rate-limit, BullMQ del worker, lock de stock).
REDIS_URL="redis://localhost:6379"

# JWT propio (access corto + refresh). MÍNIMO 32 chars c/u (HS256, validado).
JWT_SECRET="change-me-in-prod-min-32-chars-aaaaaaaaaaaa"
JWT_ACCESS_TTL=900            # segundos (15 min)
JWT_REFRESH_SECRET="change-me-refresh-min-32-chars-bbbbbbbbbbbb"
JWT_REFRESH_TTL=604800        # segundos (7 días)

# Google OAuth del backend (verificación del id_token federado).
# OJO NAMING (M14): la API lee GOOGLE_CLIENT_ID; la WEB usa AUTH_GOOGLE_ID/SECRET
# (ver sección Web). NO son la misma variable — define ambas para no romper login.
GOOGLE_CLIENT_ID=""           # vacío = login con Google deshabilitado en la API

# CORS (M6): allowlist de orígenes separados por coma. En prod, definir explícito.
CORS_ORIGIN="http://localhost:3000"
# trust proxy de Express (A3): 'true' | 'false' | nº de saltos | subred/lista.
# '' ⇒ derivado del entorno (prod=1, dev=false).
TRUST_PROXY=""

# Runtime.
PORT=3101                     # API (dev local 3101, ver ADR 0001; NO 3001)
NODE_ENV=development
LOG_LEVEL=                    # fatal|error|warn|info|debug|trace|silent ('' = por entorno)

# URL pública de la web (usada por la API para armar enlaces /r, /p de promotor).
WEB_PUBLIC_URL="http://localhost:3000"

# Object Storage S3 (§1.4 / §5) — imágenes, flyers, PDFs de tickets.
# Local: LocalStack (docker-compose). Prod: AWS_ENDPOINT="" + credenciales reales.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"             # LocalStack acepta cualquier valor; OBLIGATORIO real en prod
AWS_SECRET_ACCESS_KEY="test"         # idem
AWS_ENDPOINT="http://localhost:4566" # '' en prod => S3 real de AWS
S3_BUCKET="urnight-local"
S3_PUBLIC_URL=""                     # base CDN/pública; '' = derivar del endpoint


# ── Web  (apps/web — Next.js) ────────────────────────────────────────────────
# Vars NEXT_PUBLIC_* se exponen al navegador (no poner secretos ahí).
NEXT_PUBLIC_API_URL="http://localhost:3101/api/v1"   # base del API que consume la web
NEXT_PUBLIC_STORAGE_URL="http://localhost:4566"      # base pública de S3/LocalStack
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""                       # Google Maps JS (mapa de locales)
NEXT_PUBLIC_LOG_LEVEL="info"                         # nivel de log del cliente

# NextAuth v5 (servidor). AUTH_SECRET firma la sesión; AUTH_GOOGLE_* = OAuth de la web.
# (M14) La WEB lee AUTH_GOOGLE_ID/SECRET, NO GOOGLE_CLIENT_ID. Suele ser el mismo
# client de Google Cloud que GOOGLE_CLIENT_ID del API, con nombres distintos.
# AUTH_SECRET: ÚNICO por entorno, MIN 32 chars — validado al arrancar la web
# (apps/web/lib/config/env.schema.ts). Generar: openssl rand -base64 32
AUTH_SECRET="change-me-web-session-secret-min-32-chars"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ── Mobile / Validator  (apps/mobile, apps/validator — Expo) ─────────────────
# Vars EXPO_PUBLIC_* se embeben en el bundle del cliente (no secretos).
EXPO_PUBLIC_API_URL="http://localhost:3101/api/v1"   # base del API para las apps Expo
EXPO_PUBLIC_LOG_LEVEL="info"                          # nivel de log del cliente


# ── Infra  (docker-compose / LocalStack) ─────────────────────────────────────
# Postgres/Redis/LocalStack se levantan con `pnpm docker:up` (docker-compose.yml).
# El bucket S3 local (S3_BUCKET) lo crea el init script de LocalStack al arrancar.
