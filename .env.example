# ── Backend (apps/api, apps/worker, packages/db) ──────────────────────────
# PostgreSQL
DATABASE_URL="postgresql://urnight:urnight@localhost:5433/urnight_dev"
# Redis (sesiones, rate-limit, BullMQ, lock de stock)
REDIS_URL="redis://localhost:6379"
# JWT propio (access corto + refresh)
JWT_SECRET="change-me-in-prod-min-32-chars-aaaaaaaaaaaa"
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET="change-me-refresh-min-32-chars-bbbbbbbbbbbb"
JWT_REFRESH_TTL=604800
# Runtime
PORT=3101
NODE_ENV=development

# ── Google OAuth (OIDC) — federado ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Object Storage S3 (§1.4 / §5) — imágenes, flyers, PDFs ─────────────────
# Local: LocalStack (docker-compose). Prod: dejar AWS_ENDPOINT="" y usar AWS real.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"            # cualquier valor sirve en LocalStack
AWS_SECRET_ACCESS_KEY="test"
AWS_ENDPOINT="http://localhost:4566" # vacío en prod => S3 real de AWS
S3_BUCKET="urnight-local"
