{
  "expo": {
    "name": "Ravenue Validador",
    "slug": "ravenue-validator",
    "scheme": "ravenue-validator",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ravenue necesita la cámara para escanear códigos QR en puerta."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.ravenue.validator"
    },
    "android": {
      "package": "pe.ravenue.validator",
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
