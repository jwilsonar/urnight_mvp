{
  "expo": {
    "name": "Ravenue",
    "slug": "ravenue-mobile",
    "scheme": "ravenue",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.ravenue.mobile"
    },
    "android": {
      "package": "pe.ravenue.mobile",
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
