{
  "name": "@urnight/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --no-file-parallelism"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@urnight/contracts": "workspace:*",
    "@urnight/db": "workspace:*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "catalog:",
    "google-auth-library": "^9.15.0",
    "ioredis": "catalog:",
    "nestjs-pino": "^4.1.0",
    "pino": "catalog:",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@urnight/config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "catalog:",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
